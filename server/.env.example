DATABASE_URL=postgres://postgres:postgres@localhost:5432/flash_im
JWT_SECRET=your-jwt-secret-change-this
SERVER_PORT=9600

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# 邮箱验证码
# EMAIL_ENV=debug  # 取消注释则不真正发邮件，验证码打印到控制台
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_SMTP_HOST=smtp.example.com

# Apple 登录
APPLE_BUNDLE_ID=com.yourcompany.yourapp

# 存储后端（local / oss）
STORAGE_BACKEND=local
# UPLOAD_BASE_PATH=uploads

# 阿里云 OSS（STORAGE_BACKEND=oss 时需要）
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your-bucket-name
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_STS_ROLE_ARN=acs:ram::xxx:role/oss-upload-role

# Apple 内购
# APPLE_SHARED_SECRET=your-apple-shared-secret
# APPLE_ISSUER_ID=your-issuer-id
# APPLE_KEY_ID=your-key-id
# APPLE_PRIVATE_KEY_PATH=./keys/apple_subscription_key.p8
